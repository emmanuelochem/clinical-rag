# ---------------------------------------------------------------------------
# Minimal setup: a free Groq API key (https://console.groq.com/keys). That's it.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Chat provider: groq (default) | gemini | openai_compatible | ollama
RAG_LLM_PROVIDER=groq

# --- Gemini instead of Groq: set RAG_LLM_PROVIDER=gemini and a free key from
# --- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model overrides (leave empty for the provider's defaults):
#   groq:   openai/gpt-oss-120b (answers), openai/gpt-oss-20b (planning/reflection)
#   gemini: gemini-flash-latest, gemini-flash-lite-latest
# Model IDs change; /api/health lists the provider's live models and flags missing ones.
RAG_CHAT_MODEL=
RAG_PLANNER_MODEL=
# Optional for reasoning models such as gpt-oss: low | medium | high
RAG_REASONING_EFFORT=

# --- Any other OpenAI-compatible API (OpenRouter, Mistral, NVIDIA NIM, vLLM, LM Studio...):
# RAG_LLM_PROVIDER=openai_compatible
# RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
# RAG_LLM_API_KEY=...
# RAG_CHAT_MODEL=...

# --- Fully local with Ollama (no data leaves the machine):
# RAG_LLM_PROVIDER=ollama
# RAG_EMBED_PROVIDER=ollama
# RAG_OLLAMA_URL=http://localhost:11434

# Embeddings: local (default; runs in the backend via fastembed, no key) | ollama
RAG_EMBED_PROVIDER=local
# Default local model: BAAI/bge-small-en-v1.5. Changing it requires re-indexing:
#   python -m app.seed --wipe-all
RAG_EMBED_MODEL=

# Reranker: cross-encoder (local, default) | llm (spends LLM calls) | none
RAG_RERANKER=cross-encoder
RAG_CROSS_ENCODER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

RAG_FINAL_TOP_K=8
RAG_MAX_AGENT_ROUNDS=3
