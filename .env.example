# All settings are optional; defaults shown. Prefix: RAG_
RAG_CHAT_MODEL=qwen2.5:7b-instruct
# Smaller/faster model for planning, reflection and LLM reranking (defaults to chat model)
RAG_PLANNER_MODEL=
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_QUERY_PREFIX=search_query: 
RAG_EMBED_DOC_PREFIX=search_document: 
# cross-encoder (needs: pip install '.[rerank]', set BACKEND_EXTRAS=[rerank] for Docker) | llm | none
RAG_RERANKER=cross-encoder
RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
RAG_FINAL_TOP_K=8
RAG_MAX_AGENT_ROUNDS=3
RAG_NUM_CTX=8192
